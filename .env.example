# Which LLM provider the extraction agent uses: "anthropic" (default, paid)
# or "groq" (console.groq.com has a free tier -- good for a no-budget pilot).
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Only needed if LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: enables the search agent to pull fresh web results.
# Without it, ingestion falls back to whatever URLs you supply directly
# in data/input/companies.csv (a "sources" column of pipe-separated URLs).
TAVILY_API_KEY=
